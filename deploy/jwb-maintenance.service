[Unit]
Description=JWB statement and benefit maintenance
After=local-fs.target
[Service]
Type=oneshot
User=www
Group=www
WorkingDirectory=/www/wwwroot/jwb-cloud
ExecStart=/www/wwwroot/jwb-cloud/.venv/bin/python manage.py maintenance
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
