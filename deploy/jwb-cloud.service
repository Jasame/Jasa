[Unit]
Description=JWB Cloud Simulation
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/jwb-cloud
ExecStart=/www/wwwroot/jwb-cloud/.venv/bin/gunicorn -c gunicorn.conf.py "app:create_app()"
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
