[Unit]
Description=JWB operational health checks and administrator alerts
After=network-online.target jwb-cloud.service
[Service]
Type=oneshot
User=www
Group=www
WorkingDirectory=/www/wwwroot/jwb-cloud
ExecStart=/www/wwwroot/jwb-cloud/.venv/bin/python deploy/watchdog.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
