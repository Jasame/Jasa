# Copy to .env. Never put .env or data/ under a public static document root.
APP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_ORIGIN=https://jasa.hk
# Subdirectory mount. Set to empty only for a dedicated root-domain deployment.
BASE_PATH=/bank
COOKIE_SECURE=true
TRUST_PROXY=true
# Absolute path recommended. Must be writable by the app user only.
DATABASE=/www/wwwroot/jwb-cloud/data/jwb.sqlite3
# Read-only admin backup status. Keep consistent with the backup service directory.
BACKUP_DIR=/www/backup/jwb-cloud
# smtp for public deployment; console is for LOCAL development only.
MAIL_MODE=smtp
# Email cooldown and anti-abuse limits. Rejected retries do not consume quota.
MAIL_RESEND_SECONDS=60
MAIL_EMAIL_HOURLY_LIMIT=6
MAIL_IP_HOURLY_LIMIT=60
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional paid reference feed. Keep this key on the server.
OXR_APP_ID=
# Public daily feeds: 3600; paid plan: use a supported interval, minimum 15 seconds.
FX_REFRESH_SECONDS=3600
# Optional operational alert recipient. Empty: enabled administrator accounts.
ADMIN_ALERT_EMAIL=
# Optional local health URL; remote hosts are rejected.
OPS_HEALTH_URL=http://127.0.0.1:8895/bank/api/health
OPS_DISK_MIN_MB=512
